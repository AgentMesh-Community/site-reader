{
  "format": "agent-install-v1",
  "runtimes": [
    {
      "name": "node",
      "version": ">=22"
    }
  ],
  "binaries": [],
  "dependencies": [],
  "systems": [],
  "ceilings": [],
  "directories": [
    {
      "name": "records",
      "purpose": "every record the descriptor names"
    },
    {
      "name": "work",
      "purpose": "inputs and drafts in progress"
    }
  ],
  "job_seconds": 180,
  "price": {
    "sku": "default",
    "covers": {
      "agent": true
    },
    "price": {
      "model": "free"
    }
  },
  "run": {
    "read-site": {
      "command": [
        "node",
        "{home}/{package}/skills/read-site/scripts/read-site.mjs",
        "--job",
        "{job_dir}",
        "--records",
        "{records}",
        "--work",
        "{work}",
        "--text-file",
        "{job_dir}/message.txt"
      ],
      "reply": "json:reply",
      "per_file": [
        "--file",
        "{file_path}::{file_media_type}"
      ],
      "message_file": "{job_dir}/message.txt"
    }
  }
}
